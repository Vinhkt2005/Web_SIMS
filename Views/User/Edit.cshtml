@model Web_SIMS.Models.User

@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Quản lý Người dùng</a></li>
                <li class="breadcrumb-item active">Chỉnh sửa người dùng</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user-edit text-warning me-2"></i>Chỉnh sửa người dùng
        </h1>
        <p class="text-muted mb-0">Cập nhật thông tin tài khoản: <strong class="text-primary">@Model.FullName</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
        </a>
        <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-info">
            <i class="fas fa-eye me-2"></i>Xem chi tiết
        </a>
    </div>
</div>

<!-- Main Content -->
<div class="row g-4">
    <!-- Edit Form -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-gradient-warning text-white py-4">
                <div class="d-flex align-items-center">
                    <div class="icon-circle bg-white text-warning me-3">
                        <i class="fas fa-user-edit"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Chỉnh sửa thông tin</h5>
                        <p class="card-subtitle mb-0 opacity-75">Cập nhật thông tin tài khoản người dùng</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm" role="alert"></div>
                    
                    <!-- Personal Information Section -->
                    <div class="form-section mb-4">
                        <div class="section-header">
                            <div class="section-icon bg-primary">
                                <i class="fas fa-user"></i>
                            </div>
                            <h6 class="section-title">Thông tin cá nhân</h6>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="FullName" class="form-label-modern">
                                        <i class="fas fa-user me-2"></i>Họ và tên <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <input asp-for="FullName" class="form-input-modern" placeholder="Nhập họ và tên đầy đủ" />
                                        <div class="input-border"></div>
                                    </div>
                                    <span asp-validation-for="FullName" class="validation-message"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="Email" class="form-label-modern">
                                        <i class="fas fa-envelope me-2"></i>Email <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <input asp-for="Email" type="email" class="form-input-modern" placeholder="Nhập địa chỉ email" />
                                        <div class="input-border"></div>
                                    </div>
                                    <span asp-validation-for="Email" class="validation-message"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Account Information Section -->
                    <div class="form-section mb-4">
                        <div class="section-header">
                            <div class="section-icon bg-info">
                                <i class="fas fa-key"></i>
                            </div>
                            <h6 class="section-title">Thông tin tài khoản</h6>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="Username" class="form-label-modern">
                                        <i class="fas fa-at me-2"></i>Tên đăng nhập <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <input asp-for="Username" class="form-input-modern" placeholder="Nhập tên đăng nhập" />
                                        <div class="input-border"></div>
                                    </div>
                                    <span asp-validation-for="Username" class="validation-message"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="RoleId" class="form-label-modern">
                                        <i class="fas fa-user-tag me-2"></i>Vai trò <span class="text-danger">*</span>
                                    </label>
                                    <div class="select-wrapper">
                                        <select asp-for="RoleId" class="form-select-modern" asp-items="ViewBag.RoleId">
                                            <option value="">-- Chọn vai trò --</option>
                                        </select>
                                        <i class="fas fa-chevron-down select-arrow"></i>
                                    </div>
                                    <span asp-validation-for="RoleId" class="validation-message"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Status Section -->
                    <div class="form-section mb-4">
                        <div class="section-header">
                            <div class="section-icon bg-success">
                                <i class="fas fa-toggle-on"></i>
                            </div>
                            <h6 class="section-title">Trạng thái tài khoản</h6>
                        </div>
                        <div class="status-toggle">
                            <div class="toggle-wrapper">
                                <input asp-for="IsActive" class="toggle-input" type="checkbox" id="isActiveToggle" />
                                <label for="isActiveToggle" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">
                                        <span class="toggle-on">🟢 Hoạt động</span>
                                        <span class="toggle-off">🔴 Vô hiệu hóa</span>
                                    </span>
                                </label>
                            </div>
                            <div class="toggle-description">
                                Bật để cho phép người dùng đăng nhập vào hệ thống
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-section">
                        <div class="action-buttons">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-times me-2"></i>
                                <span>Hủy thay đổi</span>
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="fas fa-save me-2"></i>
                                <span>Cập nhật thông tin</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Information Sidebar -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-gradient-info text-white py-4">
                <div class="d-flex align-items-center">
                    <div class="icon-circle bg-white text-info me-3">
                        <i class="fas fa-info-circle"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Thông tin hiện tại</h5>
                        <p class="card-subtitle mb-0 opacity-75">Chi tiết tài khoản</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="info-items">
                    <div class="info-item">
                        <div class="info-icon bg-primary">
                            <i class="fas fa-hashtag"></i>
                        </div>
                        <div class="info-content">
                            <span class="info-label">ID Người dùng</span>
                            <span class="info-value">#@Model.UserId</span>
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-icon bg-success">
                            <i class="fas fa-calendar-plus"></i>
                        </div>
                        <div class="info-content">
                            <span class="info-label">Ngày tạo tài khoản</span>
                            <span class="info-value">@Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                            <span class="info-time">@Model.CreatedDate.ToString("HH:mm")</span>
                        </div>
                    </div>
                    
                    @if (Model.UpdatedDate.HasValue)
                    {
                        <div class="info-item">
                            <div class="info-icon bg-warning">
                                <i class="fas fa-edit"></i>
                            </div>
                            <div class="info-content">
                                <span class="info-label">Cập nhật gần nhất</span>
                                <span class="info-value">@Model.UpdatedDate?.ToString("dd/MM/yyyy")</span>
                                <span class="info-time">@Model.UpdatedDate?.ToString("HH:mm")</span>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Quick Actions -->
                <div class="quick-actions mt-4">
                    <h6 class="quick-actions-title">Thao tác nhanh</h6>
                    <div class="quick-action-buttons">
                        <a asp-action="Details" asp-route-id="@Model.UserId" class="quick-action-btn">
                            <i class="fas fa-eye"></i>
                            <span>Xem chi tiết</span>
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.UserId" class="quick-action-btn text-danger">
                            <i class="fas fa-trash"></i>
                            <span>Xóa tài khoản</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Icon Circle */
        .icon-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        /* Form Sections */
        .form-section {
            border-left: 4px solid #e3e6f0;
            padding-left: 1.5rem;
            margin-left: 1rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .section-icon {
            width: 35px;
            height: 35px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-right: 0.75rem;
        }

        .section-title {
            margin: 0;
            font-weight: 600;
            color: #2c3e50;
        }

        /* Modern Form Groups */
        .form-group-modern {
            margin-bottom: 1.5rem;
        }

        .form-label-modern {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 0.5rem;
            display: block;
        }

        .input-wrapper {
            position: relative;
        }

        .form-input-modern {
            width: 100%;
            border: 2px solid #e3e6f0;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #fff;
        }

        .form-input-modern:focus {
            border-color: #4e73df;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
            outline: none;
        }

        .input-border {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            transition: width 0.3s ease;
        }

        .form-input-modern:focus + .input-border {
            width: 100%;
        }

        /* Select Wrapper */
        .select-wrapper {
            position: relative;
        }

        .form-select-modern {
            appearance: none;
            background: #fff;
            border: 2px solid #e3e6f0;
            border-radius: 8px;
            padding: 0.75rem 2.5rem 0.75rem 1rem;
            font-size: 1rem;
            transition: all 0.3s ease;
            width: 100%;
        }

        .form-select-modern:focus {
            border-color: #4e73df;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
            outline: none;
        }

        .select-arrow {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            pointer-events: none;
        }

        /* Toggle Switch */
        .status-toggle {
            padding-left: 2.75rem;
        }

        .toggle-wrapper {
            display: flex;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .toggle-input {
            display: none;
        }

        .toggle-label {
            display: flex;
            align-items: center;
            cursor: pointer;
            user-select: none;
        }

        .toggle-slider {
            width: 60px;
            height: 30px;
            background: #ccc;
            border-radius: 15px;
            position: relative;
            transition: all 0.3s ease;
            margin-right: 1rem;
        }

        .toggle-slider::before {
            content: '';
            position: absolute;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: white;
            top: 2px;
            left: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .toggle-input:checked + .toggle-label .toggle-slider {
            background: #28a745;
        }

        .toggle-input:checked + .toggle-label .toggle-slider::before {
            transform: translateX(30px);
        }

        .toggle-text {
            font-weight: 600;
        }

        .toggle-on, .toggle-off {
            display: none;
        }

        .toggle-input:checked + .toggle-label .toggle-on {
            display: inline;
        }

        .toggle-input:not(:checked) + .toggle-label .toggle-off {
            display: inline;
        }

        .toggle-description {
            color: #6c757d;
            font-size: 0.9rem;
            font-style: italic;
        }

        /* Action Section */
        .action-section {
            background: linear-gradient(135deg, #f8f9fc 0%, #e3e6f0 100%);
            border-radius: 12px;
            padding: 2rem;
            margin-top: 2rem;
        }

        .action-buttons {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .btn-lg {
            padding: 0.75rem 2rem;
            font-size: 1.1rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-warning {
            background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
            border: none;
            color: #212529;
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
        }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 193, 7, 0.4);
            color: #212529;
        }

        .btn-outline-secondary {
            border: 2px solid #6c757d;
            color: #6c757d;
        }

        .btn-outline-secondary:hover {
            background: #6c757d;
            transform: translateY(-2px);
        }

        /* Info Items */
        .info-items {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .info-item {
            display: flex;
            align-items: center;
            padding: 1rem;
            background: #f8f9fc;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .info-item:hover {
            background: #e3e6f0;
            transform: translateX(5px);
        }

        .info-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-right: 1rem;
            flex-shrink: 0;
        }

        .info-content {
            display: flex;
            flex-direction: column;
        }

        .info-label {
            font-size: 0.8rem;
            color: #6c757d;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-weight: 600;
            color: #2c3e50;
            margin-top: 0.25rem;
        }

        .info-time {
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 0.1rem;
        }

        /* Quick Actions */
        .quick-actions {
            border-top: 1px solid #e3e6f0;
            padding-top: 1rem;
        }

        .quick-actions-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1rem;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .quick-action-buttons {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .quick-action-btn {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            background: #fff;
            border: 1px solid #e3e6f0;
            border-radius: 8px;
            text-decoration: none;
            color: #2c3e50;
            transition: all 0.3s ease;
        }

        .quick-action-btn:hover {
            background: #f8f9fc;
            transform: translateX(5px);
            color: #2c3e50;
        }

        .quick-action-btn i {
            margin-right: 0.75rem;
            width: 16px;
        }

        /* Validation Messages */
        .validation-message {
            color: #e74a3b;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: block;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .action-buttons {
                flex-direction: column;
            }
            
            .form-section {
                padding-left: 1rem;
                margin-left: 0.5rem;
            }
            
            .section-header {
                margin-bottom: 1rem;
            }
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}