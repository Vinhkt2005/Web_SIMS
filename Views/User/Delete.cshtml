@model Web_SIMS.Models.User

@{
    ViewData["Title"] = "Xóa người dùng";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-0 text-gray-800">
                        <i class="fas fa-user-times me-2 text-danger"></i>Xóa người dùng
                    </h1>
                    <p class="text-muted">Xác nhận xóa người dùng khỏi hệ thống</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-secondary me-2">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại
                    </a>
                    <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-info">
                        <i class="fas fa-eye me-2"></i>Xem chi tiết
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa người dùng
                    </h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa người dùng này không? 
                        Hành động này sẽ vô hiệu hóa tài khoản và không thể hoàn tác.
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Họ và tên:</strong>
                        </div>
                        <div class="col-sm-9">
                            @Model.FullName
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Username:</strong>
                        </div>
                        <div class="col-sm-9">
                            <span class="badge bg-info">@Model.Username</span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Vai trò:</strong>
                        </div>
                        <div class="col-sm-9">
                            <span class="badge bg-@(Model.Role?.RoleName == "Admin" ? "danger" : Model.Role?.RoleName == "Faculty" ? "warning" : "info") fs-6">
                                @Model.Role?.RoleName
                            </span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Trạng thái:</strong>
                        </div>
                        <div class="col-sm-9">
                            <span class="badge bg-@(Model.IsActive ? "success" : "secondary") fs-6">
                                @(Model.IsActive ? "Hoạt động" : "Không hoạt động")
                            </span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Ngày tạo:</strong>
                        </div>
                        <div class="col-sm-9">
                            @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <hr>

                    <form asp-action="DeleteConfirmed" asp-route-id="@Model.UserId" method="post">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                            <button type="submit" class="btn btn-danger" 
                                    onclick="return confirm('Bạn có chắc chắn muốn xóa người dùng này không?')">
                                <i class="fas fa-trash me-2"></i>Xác nhận xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow border-warning">
                <div class="card-header bg-warning text-dark py-3">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-info-circle me-2"></i>Thông tin quan trọng
                    </h6>
                </div>
                <div class="card-body">
                    <h6>Khi xóa người dùng:</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-warning me-2"></i>
                            Tài khoản sẽ bị vô hiệu hóa
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-warning me-2"></i>
                            Không thể đăng nhập vào hệ thống
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-warning me-2"></i>
                            Dữ liệu liên quan vẫn được giữ lại
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-warning me-2"></i>
                            Có thể khôi phục bằng cách kích hoạt lại
                        </li>
                    </ul>
                </div>
            </div>

            @if (Model.Role?.RoleName == "Admin")
            {
                <div class="card shadow border-danger mt-4">
                    <div class="card-header bg-danger text-white py-3">
                        <h6 class="m-0 font-weight-bold">
                            <i class="fas fa-exclamation-triangle me-2"></i>Cảnh báo đặc biệt
                        </h6>
                    </div>
                    <div class="card-body">
                        <p class="text-danger">
                            <strong>Đây là tài khoản Admin!</strong>
                        </p>
                        <p class="text-muted">
                            Hãy cân nhắc kỹ trước khi xóa tài khoản quản trị viên. 
                            Đảm bảo có ít nhất một tài khoản Admin khác hoạt động.
                        </p>
                    </div>
                </div>
            }

            <div class="card shadow mt-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-secondary">
                        <i class="fas fa-history me-2"></i>Thao tác khác
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit me-2"></i>Chỉnh sửa thay vì xóa
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-info btn-sm">
                            <i class="fas fa-eye me-2"></i>Xem chi tiết
                        </a>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">
                            <i class="fas fa-list me-2"></i>Danh sách người dùng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>