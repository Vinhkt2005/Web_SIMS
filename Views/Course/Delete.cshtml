@model Web_SIMS.Models.Course

@{
    ViewData["Title"] = "Xóa khóa học";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-danger">
                        <i class="fas fa-trash me-2"></i>Xác nhận xóa khóa học
                    </h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa khóa học này không? Hành động này không thể hoàn tác.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-danger mb-3">
                                <i class="fas fa-info-circle me-2"></i>Thông tin khóa học
                            </h5>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-id-card me-2"></i>Mã khóa học
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">@Model.CourseCode</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-book me-2"></i>Tên khóa học
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">@Model.CourseName</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-align-left me-2"></i>Mô tả
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">@(Model.Description ?? "Không có mô tả")</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-graduation-cap me-2"></i>Số tín chỉ
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">@Model.Credits</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-danger mb-3">
                                <i class="fas fa-cogs me-2"></i>Thông tin chi tiết
                            </h5>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-users me-2"></i>Số sinh viên tối đa
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">@Model.MaxStudents</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-calendar me-2"></i>Học kỳ
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">@Model.Semester</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-calendar-alt me-2"></i>Năm học
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">@Model.AcademicYear</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-chalkboard-teacher me-2"></i>Giảng viên
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">@Model.Instructor</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-toggle-on me-2"></i>Trạng thái
                                </label>
                                <p class="form-control-plaintext border p-2 bg-light">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Không hoạt động</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Hủy bỏ
                                </a>
                                <form asp-action="DeleteConfirmed" asp-route-id="@Model.CourseId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa khóa học này không?')">
                                        <i class="fas fa-trash me-2"></i>Xác nhận xóa
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>