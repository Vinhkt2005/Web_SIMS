                        <span>Vào Dashboard</span>
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-cta btn-cta-primary">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        <span>Đăng nhập ngay</span>
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                }
                <a href="#features" class="btn btn-cta btn-cta-outline ms-3">
