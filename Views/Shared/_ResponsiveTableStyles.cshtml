@{
    Layout = null;
}

<style>
/* Responsive Table Improvements */
.table-responsive {
    border-radius: 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    overflow-x: auto;
}

/* Fixed width for action column */
.table th:last-child,
.table td:last-child {
    width: 120px;
    min-width: 120px;
    max-width: 120px;
    white-space: nowrap;
}

/* Cải thiện hiển thị chung cho tất cả bảng */
.table-responsive {
    border: 1px solid #dee2e6;
    border-radius: 0.5rem;
}

.table {
    margin-bottom: 0;
    border-collapse: separate;
    border-spacing: 0;
}

.table th {
    border-bottom: 2px solid #dee2e6;
    background-color: #f8f9fa;
    font-weight: 600;
    text-align: center;
    vertical-align: middle;
}

.table td {
    border-bottom: 1px solid #dee2e6;
    vertical-align: middle;
}

/* Đảm bảo text không bị overflow */
.table th,
.table td {
    position: relative;
    padding: 0.75rem 0.5rem;
}

/* Ensure table doesn't exceed container */
.table {
    min-width: 800px; /* Minimum width to prevent cramping */
}

/* Action buttons container */
.action-buttons {
    position: relative;
    min-width: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Quick actions - hidden by default, shown on hover */
.quick-actions {
    display: flex;
    gap: 4px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    background: white;
    padding: 4px;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 10;
}

/* Show quick actions on row hover */
tr:hover .quick-actions {
    opacity: 1;
    visibility: visible;
}

/* Action button styles */
.btn-action {
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    position: relative;
}

.btn-action:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.btn-action-primary {
    background: linear-gradient(135deg, #4f46e5, #6366f1);
    color: white;
}

.btn-action-warning {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
}

.btn-action-success {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
}

.btn-action-danger {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
}

.btn-action-secondary {
    background: linear-gradient(135deg, #6b7280, #4b5563);
    color: white;
}

.btn-action-info {
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    color: white;
}

/* Dropdown toggle for mobile */
.action-dropdown-toggle {
    display: none;
}

/* Responsive breakpoints */
@@media (max-width: 1400px) {
    /* Hide Chuyên môn column on smaller screens */
    .table th:nth-child(5),
    .table td:nth-child(5) {
        display: none;
    }
}

@@media (max-width: 1200px) {
    /* Hide Tài khoản column */
    .table th:nth-child(6),
    .table td:nth-child(6) {
        display: none;
    }
    
    /* Make table more compact */
    .table th,
    .table td {
        padding: 0.5rem 0.375rem;
        font-size: 0.9rem;
    }
}

@@media (max-width: 992px) {
    /* Hide Email column on tablets */
    .table th:nth-child(3),
    .table td:nth-child(3) {
        display: none;
    }
    
    /* Reduce action button size */
    .btn-action {
        width: 28px;
        height: 28px;
        font-size: 0.75rem;
    }
    
    .quick-actions {
        gap: 2px;
        padding: 2px;
    }
}

@@media (max-width: 768px) {
    /* Mobile view - hide quick actions, show dropdown only */
    .quick-actions {
        display: none !important;
    }
    
    .action-dropdown-toggle {
        display: block !important;
    }
    
    /* Hide Khoa column on mobile */
    .table th:nth-child(4),
    .table td:nth-child(4) {
        display: none;
    }
    
    /* Make table more compact */
    .table td,
    .table th {
        padding: 0.5rem 0.25rem;
        font-size: 0.875rem;
    }
    
    /* Stack content in cells */
    .table td > div {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    
    .table td small {
        font-size: 0.75rem;
    }
}

@@media (max-width: 576px) {
    /* Extra small screens */
    .table th:nth-child(3),
    .table td:nth-child(3) {
        display: none;
    }
    
    .table td,
    .table th {
        padding: 0.375rem 0.125rem;
        font-size: 0.8rem;
    }
    
    .action-buttons {
        min-width: 60px;
    }
    
    .btn-action {
        width: 24px;
        height: 24px;
        font-size: 0.7rem;
    }
}

/* Faculty Management specific styles */
.faculty-table .table {
    table-layout: fixed;
    width: 100%;
    min-width: 700px; /* Giảm min-width do bỏ thêm cột email */
}

/* Tính toán lại width cho 5 cột (bỏ email) */
.faculty-table .table th:nth-child(1) { width: 15%; } /* Mã GV */
.faculty-table .table th:nth-child(2) { width: 35%; } /* Họ và tên */
.faculty-table .table th:nth-child(3) { width: 20%; } /* Khoa */
.faculty-table .table th:nth-child(4) { width: 20%; } /* Chuyên môn */
.faculty-table .table th:nth-child(5) { width: 10%; min-width: 120px; } /* Thao tác */

/* Đảm bảo text không bị overflow */
.faculty-table .table th,
.faculty-table .table td {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.75rem 0.5rem;
}

/* Cho phép text wrap cho cột họ tên */
