@model IEnumerable<Web_SIMS.Models.Course?>
@{
    ViewData["Title"] = "Môn học của tôi";
}

@section Styles {
<style>
    .course-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden;
    }

    .course-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .course-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        text-decoration: none;
        color: white;
    }

    .course-card:hover::before {
        opacity: 1;
    }

    .course-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .course-code {
        background: rgba(255,255,255,0.2);
        padding: 0.5rem 1rem;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
    }

    .course-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        line-height: 1.3;
    }

    .course-credits {
        display: flex;
        align-items: center;
        font-size: 1rem;
        opacity: 0.9;
    }

    .course-icon {
        width: 60px;
        height: 60px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
        backdrop-filter: blur(10px);
    }

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 30px 30px;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
        padding: 0 1rem;
    }

    .stats-card {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

    .stats-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 0.5rem;
    }

    .stats-label {
        color: #6c757d;
        font-weight: 500;
    }

    @@media (max-width: 768px) {
        .courses-grid {
            grid-template-columns: 1fr;
            padding: 0 0.5rem;
        }
        
        .page-title {
            font-size: 2rem;
        }
        
        .course-header {
            flex-direction: column;
            gap: 1rem;
        }
        
        .course-code {
            align-self: flex-start;
        }
    }

    @@media (max-width: 576px) {
        .course-card {
            padding: 1rem;
        }
        
        .course-title {
            font-size: 1.2rem;
        }
        
        .page-header {
            padding: 2rem 0;
        }
    }
</style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="page-title">
                    <i class="fas fa-graduation-cap me-3"></i>Môn học của tôi
                </h1>
                <p class="page-subtitle">Quản lý và theo dõi các môn học bạn đang tham gia</p>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <div class="stats-number">@Model.Count()</div>
                    <div class="stats-label">Môn học đang học</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container py-4">
    @if (Model.Any())
    {
        <div class="courses-grid">
            @foreach (var course in Model)
            {
                <a asp-action="CourseDetails" asp-route-id="@course?.CourseId" class="course-card">
                    <div class="course-icon">
                        <i class="fas fa-book-open"></i>
                    </div>
                    
                    <div class="course-header">
                        <div class="course-info">
                            <h3 class="course-title">@course?.CourseName</h3>
                            <div class="course-credits">
                                <i class="fas fa-star me-2"></i>
                                @course?.Credits tín chỉ
                            </div>
                        </div>
                        <div class="course-code">
                            @course?.CourseCode
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-white-50">
                            <i class="fas fa-arrow-right me-2"></i>Xem chi tiết
                        </span>
                        <i class="fas fa-chevron-right"></i>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-book-open text-muted" style="font-size: 4rem;"></i>
            </div>
            <h4 class="text-muted">Chưa có môn học nào</h4>
            <p class="text-muted">Bạn chưa đăng ký môn học nào. Hãy liên hệ với phòng đào tạo để đăng ký môn học.</p>
        </div>
    }
</div>