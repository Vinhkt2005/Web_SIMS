@model Web_SIMS.ViewModels.FacultyHomeViewModel
@{
    ViewData["Title"] = "Trang chủ Giảng viên";
}

<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="faculty-welcome-header p-4 rounded-3 text-white">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h1 class="mb-2"><i class="fas fa-chalkboard-teacher me-3"></i>Chào mừng Giảng viên!</h1>
                        <p class="mb-0 fs-5 opacity-90">Hôm nay là một ngày tuyệt vời để truyền cảm hứng học tập</p>
                    </div>
                    <div class="col-md-4 text-end">
                        <div class="current-time">
                            <i class="fas fa-clock me-2"></i>
                            <span id="facultyCurrentTime"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-lg-6 col-md-6 mb-3">
            <div class="faculty-stats-card card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <div class="faculty-stats-icon mb-3 teaching-icon">
                        <i class="fas fa-chalkboard"></i>
                    </div>
                    <div class="faculty-stats-label">Lớp đang dạy</div>
                    <div class="faculty-stats-value">@Model.ClassCount</div>
                    <div class="faculty-stats-desc">Lớp học hiện tại</div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 mb-3">
            <div class="faculty-stats-card card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <div class="faculty-stats-icon mb-3 student-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="faculty-stats-label">Tổng sinh viên</div>
                    <div class="faculty-stats-value">@Model.StudentCount</div>
                    <div class="faculty-stats-desc">Sinh viên đang theo học</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Thao tác nhanh</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <a class="btn btn-primary btn-lg w-100 faculty-action-btn" asp-action="MyClasses">
                                <i class="fas fa-book-open me-3"></i>
                                <div>
                                    <div class="fw-bold">Lớp của tôi</div>
                                    <small class="opacity-75">Quản lý các lớp học đang giảng dạy</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6 mb-3">
                            <a class="btn btn-outline-primary btn-lg w-100 faculty-action-btn" asp-action="GradeReports">
                                <i class="fas fa-chart-line me-3"></i>
                                <div>
                                    <div class="fw-bold">Báo cáo điểm số</div>
                                    <small class="opacity-75">Xem và quản lý điểm số sinh viên</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* 🎨 Faculty Portal Home Styles */
.faculty-welcome-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 15px !important;
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
}

.current-time {
    font-size: 1.1rem;
    font-weight: 500;
}

.faculty-stats-card {
    transition: all 0.3s ease;
    border-radius: 12px !important;
    overflow: hidden;
}

.faculty-stats-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
}

.faculty-stats-icon {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    font-size: 1.8rem;
    color: white;
}

.teaching-icon {
    background: linear-gradient(135deg, #667eea, #764ba2);
}

.student-icon {
    background: linear-gradient(135deg, #f093fb, #f5576c);
}

.faculty-stats-label {
    font-size: 0.9rem;
    color: #6c757d;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
}

.faculty-stats-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: #2d3436;
    margin-bottom: 0.3rem;
}

.faculty-stats-desc {
    font-size: 0.85rem;
    color: #74b9ff;
    font-weight: 500;
}

.faculty-action-btn {
    text-align: left;
    padding: 1.5rem;
    border-radius: 12px;
    transition: all 0.3s ease;
    text-decoration: none;
    display: flex;
    align-items: center;
}

.faculty-action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

.faculty-action-btn i {
    font-size: 2rem;
    width: 60px;
}

.card {
    border-radius: 12px !important;
}

.card-header {
    border-radius: 12px 12px 0 0 !important;
}

/* Animation cho thời gian */
#facultyCurrentTime {
    font-family: 'Courier New', monospace;
    font-weight: bold;
}

/* Responsive */
@@media (max-width: 768px) {
    .faculty-welcome-header h1 {
        font-size: 1.5rem;
    }
    
    .faculty-welcome-header p {
        font-size: 1rem;
    }
    
    .current-time {
        text-align: center !important;
        margin-top: 1rem;
    }
    
    .faculty-stats-value {
        font-size: 2rem;
    }
    
    .faculty-action-btn {
        text-align: center;
    }
    
    .faculty-action-btn i {
        width: auto;
        margin-right: 1rem;
    }
}
</style>

<script>
// Hiển thị thời gian hiện tại cho Faculty
function updateFacultyTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString('vi-VN', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
    });
    const dateString = now.toLocaleDateString('vi-VN', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
    
    const timeElement = document.getElementById('facultyCurrentTime');
    if (timeElement) {
        timeElement.innerHTML = `${timeString}<br><small>${dateString}</small>`;
    }
}

// Cập nhật thời gian mỗi giây
setInterval(updateFacultyTime, 1000);
updateFacultyTime(); // Gọi ngay lập tức
</script>
