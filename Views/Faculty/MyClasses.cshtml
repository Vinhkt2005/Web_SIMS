@model List<Web_SIMS.Models.Course>
@{
    ViewData["Title"] = "Lớp của tôi";
}

<style>
    .classes-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .classes-header {
        text-align: center;
        margin-bottom: 2rem;
        color: white;
    }

    .classes-title {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .classes-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .classes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .class-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        transition: all 0.3s ease;
        animation: slideUp 0.6s ease-out;
        position: relative;
    }

    .class-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.2);
    }

    .class-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        padding: 1.5rem;
        color: white;
        position: relative;
    }

    .class-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="pattern" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="10" cy="10" r="1" fill="white" opacity="0.2"/></pattern></defs><rect width="100" height="100" fill="url(%23pattern)"/></svg>');
    }

    .class-code {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-bottom: 0.5rem;
        position: relative;
        z-index: 2;
    }

    .class-name {
        font-size: 1.3rem;
        font-weight: 600;
        margin: 0;
        position: relative;
        z-index: 2;
    }

    .class-body {
        padding: 1.5rem;
    }

    .student-count {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 10px;
        border-left: 4px solid #4facfe;
    }

    .student-count-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        margin-right: 1rem;
    }

    .student-count-info h4 {
        margin: 0;
        font-size: 1.5rem;
        color: #2c3e50;
        font-weight: bold;
    }

    .student-count-info p {
        margin: 0;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .class-actions {
        display: flex;
        gap: 0.5rem;
    }

    .action-btn {
        flex: 1;
        padding: 12px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-students {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
    }

    .btn-students:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(79, 172, 254, 0.6);
        color: white;
        text-decoration: none;
    }

    .btn-grades {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.4);
    }

    .btn-grades:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(40, 167, 69, 0.6);
        color: white;
        text-decoration: none;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: white;
    }

    .empty-state i {
        font-size: 5rem;
        margin-bottom: 1rem;
        opacity: 0.7;
    }

    .empty-state h3 {
        margin-bottom: 1rem;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .classes-container {
            padding: 1rem 0;
        }

        .classes-title {
            font-size: 2rem;
        }

        .classes-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
            margin-top: 1rem;
        }

        .class-card {
            margin: 0 1rem;
        }

        .class-actions {
            flex-direction: column;
        }

        .action-btn {
            padding: 10px 15px;
        }
    }

    @@media (max-width: 480px) {
        .classes-container {
            padding: 0.5rem 0;
        }

        .class-header {
            padding: 1rem;
        }

        .class-body {
            padding: 1rem;
        }

        .student-count {
            padding: 0.8rem;
        }

        .student-count-icon {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }
    }

    /* Animations */
    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="classes-container">
    <div class="container">
        <!-- Header -->
        <div class="classes-header">
            <h1 class="classes-title">
                <i class="fas fa-chalkboard-teacher me-3"></i>
                Lớp của tôi
            </h1>
            <p class="classes-subtitle">Quản lý các lớp học bạn đang giảng dạy</p>
        </div>

        @if (Model.Any())
        {
            <!-- Classes Grid -->
            <div class="classes-grid">
                @foreach (var course in Model)
                {
                    <div class="class-card">
                        <!-- Class Header -->
                        <div class="class-header">
                            <div class="class-code">@course.CourseCode</div>
                            <h3 class="class-name">@course.CourseName</h3>
                        </div>

                        <!-- Class Body -->
                        <div class="class-body">
                            <!-- Student Count -->
                            <div class="student-count">
                                <div class="student-count-icon">
                                    <i class="fas fa-users"></i>
                                </div>
                                <div class="student-count-info">
                                    <h4>@(course.Enrollments?.Count(e => e.Status == EnrollmentStatus.Approved) ?? 0)</h4>
                                    <p>Sinh viên đã đăng ký</p>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="class-actions">
                                <a asp-action="Students" asp-route-classId="@course.CourseId" class="action-btn btn-students">
                                    <i class="fas fa-user-graduate"></i>
                                    Sinh viên
                                </a>
                                <a asp-action="Grades" asp-route-classId="@course.CourseId" class="action-btn btn-grades">
                                    <i class="fas fa-clipboard-list"></i>
                                    Nhập điểm
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="empty-state">
                <i class="fas fa-chalkboard"></i>
                <h3>Chưa có lớp học nào</h3>
                <p>Bạn chưa được phân công giảng dạy lớp học nào.</p>
            </div>
        }
    </div>
</div>
