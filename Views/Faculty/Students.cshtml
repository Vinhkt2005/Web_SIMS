@model List<Web_SIMS.Models.Enrollment>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<style>
    .students-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .students-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        animation: slideUp 0.6s ease-out;
    }

    .students-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        padding: 2rem;
        text-align: center;
        color: white;
        position: relative;
    }

    .students-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="10" cy="10" r="1" fill="white" opacity="0.2"/></pattern></defs><rect width="100" height="100" fill="url(%23dots)"/></svg>');
    }

    .course-info {
        position: relative;
        z-index: 2;
    }

    .course-title {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .course-code {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .students-body {
        padding: 2rem;
    }

    .student-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .student-card {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
        border-left: 4px solid #4facfe;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        animation: fadeInUp 0.6s ease-out forwards;
        opacity: 0;
    }

    .student-card:nth-child(1) { animation-delay: 0.1s; }
    .student-card:nth-child(2) { animation-delay: 0.2s; }
    .student-card:nth-child(3) { animation-delay: 0.3s; }
    .student-card:nth-child(4) { animation-delay: 0.4s; }
    .student-card:nth-child(5) { animation-delay: 0.5s; }
    .student-card:nth-child(6) { animation-delay: 0.6s; }

    .student-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(79, 172, 254, 0.05) 0%, rgba(0, 242, 254, 0.05) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .student-card:hover::before {
        opacity: 1;
    }

    .student-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        border-left-color: #00f2fe;
    }

    .student-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        font-weight: bold;
        margin-bottom: 1rem;
        position: relative;
        z-index: 2;
    }

    .student-info {
        position: relative;
        z-index: 2;
    }

    .student-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .student-code {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .student-email {
        color: #4facfe;
        font-size: 0.9rem;
        text-decoration: none;
    }

    .student-email:hover {
        text-decoration: underline;
    }

    .stats-section {
        background: #e9ecef;
        padding: 1.5rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        text-align: center;
    }

    .stats-number {
        font-size: 2rem;
        font-weight: bold;
        color: #4facfe;
    }

    .stats-label {
        color: #6c757d;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .back-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 12px 25px;
        border-radius: 25px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .back-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
        color: white;
        text-decoration: none;
    }

    .back-btn i {
        margin-right: 0.5rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 4rem;
        margin-bottom: 1rem;
        color: #dee2e6;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .students-container {
            padding: 1rem 0;
        }

        .students-header {
            padding: 1.5rem;
        }

        .course-title {
            font-size: 1.5rem;
        }

        .students-body {
            padding: 1rem;
        }

        .student-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .student-card {
            padding: 1rem;
        }
    }

    /* Animations */
    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="students-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="students-card">
                    <!-- Header -->
                    <div class="students-header">
                        <div class="course-info">
                            <h1 class="course-title">@ViewBag.CourseName</h1>
                            <p class="course-code">Mã lớp: @ViewBag.CourseCode</p>
                        </div>
                    </div>

                    <!-- Body -->
                    <div class="students-body">
                        <!-- Stats -->
                        <div class="stats-section">
                            <div class="stats-number">@Model.Count</div>
                            <div class="stats-label">Sinh viên đã đăng ký</div>
                        </div>

                        @if (Model.Any())
                        {
                            <!-- Students Grid -->
                            <div class="student-grid">
                                @foreach (var enrollment in Model)
                                {
                                    <div class="student-card">
                                        <div class="d-flex align-items-start">
                                            <div class="student-avatar">
                                                @if (!string.IsNullOrEmpty(enrollment.Student?.FullName))
                                                {
                                                    @enrollment.Student.FullName.Split(' ').FirstOrDefault()?.Substring(0, 1).ToUpper()@enrollment.Student.FullName.Split(' ').LastOrDefault()?.Substring(0, 1).ToUpper()
                                                }
                                                else
                                                {
                                                    <text>SV</text>
                                                }
                                            </div>
                                            <div class="student-info flex-grow-1 ms-3">
                                                <div class="student-name">@(enrollment.Student?.FullName ?? "N/A")</div>
                                                <div class="student-code">
                                                    <i class="fas fa-id-card me-1"></i>
                                                    @(enrollment.Student?.StudentCode ?? "N/A")
                                                </div>
                                                @if (!string.IsNullOrEmpty(enrollment.Student?.Email))
                                                {
                                                    <a href="mailto:@enrollment.Student.Email" class="student-email">
                                                        <i class="fas fa-envelope me-1"></i>
                                                        @enrollment.Student.Email
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-user-graduate"></i>
                                <h4>Chưa có sinh viên nào đăng ký</h4>
                                <p>Lớp học này chưa có sinh viên nào đăng ký tham gia.</p>
                            </div>
                        }

                        <!-- Back Button -->
                        <div class="text-center mt-4">
                            <a href="@Url.Action("MyClasses")" class="back-btn">
                                <i class="fas fa-arrow-left"></i>
                                Quay lại danh sách lớp
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>