@model Web_SIMS.Models.Faculty

@{
    ViewData["Title"] = "Chỉnh sửa thông tin giảng viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/faculty-edit.css" />
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Quản lý Giảng viên</a></li>
                <li class="breadcrumb-item active">Chỉnh sửa giảng viên</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user-edit me-2 text-warning"></i>Chỉnh sửa thông tin giảng viên
        </h1>
        <p class="text-muted mb-0">Cập nhật thông tin chi tiết của giảng viên @Model.FullName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.FacultyId" class="btn btn-outline-info">
            <i class="fas fa-eye me-2"></i>Xem chi tiết
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>
</div>

<!-- Faculty Edit Form -->
<div class="row">
    <div class="col-12">
        <div class="edit-form-container">
            <!-- Faculty Profile Header -->
            <div class="faculty-edit-header">
                <div class="faculty-avatar-edit">
                    <div class="avatar-circle-edit">
                        <span class="avatar-text-edit">@Model.FullName.Substring(0, 1).ToUpper()</span>
                    </div>
                    <div class="status-indicator-edit @(Model.IsActive ? "active" : "inactive")"></div>
                </div>
                <div class="faculty-info-edit">
                    <h3 class="faculty-name-edit">@Model.FullName</h3>
                    <div class="faculty-meta-edit">
                        <span class="faculty-code-edit">@Model.FacultyCode</span>
                        <span class="separator">•</span>
                        <span class="faculty-department-edit">@(Model.Department ?? "Chưa phân khoa")</span>
                    </div>
                </div>
                <div class="edit-badge">
                    <i class="fas fa-edit me-1"></i>
                    Đang chỉnh sửa
                </div>
            </div>

            <!-- Form Content -->
            <form asp-action="Edit" asp-route-id="@Model.FacultyId" method="post" class="edit-form" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern" role="alert"></div>
                <input type="hidden" asp-for="FacultyId" />

                <div class="form-sections">
                    <!-- Personal Information Section -->
                    <div class="form-section">
                        <div class="section-header">
                            <div class="section-icon personal">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="section-title">
                                <h4>Thông tin cá nhân</h4>
                                <p>Cập nhật thông tin cơ bản của giảng viên</p>
                            </div>
                        </div>
                        <div class="section-content">
                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label asp-for="FacultyCode" class="form-label-modern">
                                            <i class="fas fa-id-card"></i>
                                            Mã giảng viên
                                        </label>
                                        <input asp-for="FacultyCode" class="form-control-modern" placeholder="VD: GV001" />
                                        <span asp-validation-for="FacultyCode" class="validation-message"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label asp-for="FullName" class="form-label-modern">
                                            <i class="fas fa-user"></i>
                                            Họ và tên
                                        </label>
                                        <input asp-for="FullName" class="form-control-modern" placeholder="Nhập họ và tên đầy đủ" />
                                        <span asp-validation-for="FullName" class="validation-message"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label asp-for="Email" class="form-label-modern">
                                            <i class="fas fa-envelope"></i>
                                            Email
                                        </label>
                                        <input asp-for="Email" type="email" class="form-control-modern" placeholder="example@email.com" />
                                        <span asp-validation-for="Email" class="validation-message"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label asp-for="PhoneNumber" class="form-label-modern">
                                            <i class="fas fa-phone"></i>
                                            Số điện thoại
                                        </label>
                                        <input asp-for="PhoneNumber" class="form-control-modern" placeholder="0123456789" />
                                        <span asp-validation-for="PhoneNumber" class="validation-message"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label asp-for="DateOfBirth" class="form-label-modern">
                                            <i class="fas fa-calendar"></i>
                                            Ngày sinh
                                        </label>
                                        <input asp-for="DateOfBirth" type="date" class="form-control-modern" />
                                        <span asp-validation-for="DateOfBirth" class="validation-message"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label asp-for="Gender" class="form-label-modern">
                                            <i class="fas fa-venus-mars"></i>
                                            Giới tính
                                        </label>
                                        <select asp-for="Gender" class="form-select-modern">
                                            <option value="">Chọn giới tính</option>
                                            <option value="Nam">Nam</option>
                                            <option value="Nữ">Nữ</option>
                                            <option value="Khác">Khác</option>
                                        </select>
                                        <span asp-validation-for="Gender" class="validation-message"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Academic Information Section -->
                    <div class="form-section">
                        <div class="section-header">
                            <div class="section-icon academic">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <div class="section-title">
                                <h4>Thông tin học thuật</h4>
                                <p>Cập nhật khoa, chuyên môn và địa chỉ</p>
                            </div>
                        </div>
                        <div class="section-content">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label asp-for="Department" class="form-label-modern">
                                            <i class="fas fa-building"></i>
                                            Khoa
                                        </label>
                                        <input asp-for="Department" class="form-control-modern" placeholder="VD: Công nghệ thông tin" />
                                        <span asp-validation-for="Department" class="validation-message"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label asp-for="Specialization" class="form-label-modern">
                                            <i class="fas fa-microscope"></i>
                                            Chuyên môn
                                        </label>
                                        <input asp-for="Specialization" class="form-control-modern" placeholder="VD: Lập trình" />
                                        <span asp-validation-for="Specialization" class="validation-message"></span>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-group-modern">
                                        <label asp-for="Address" class="form-label-modern">
                                            <i class="fas fa-map-marker-alt"></i>
                                            Địa chỉ
                                        </label>
                                        <textarea asp-for="Address" class="form-control-modern textarea-modern" rows="3" placeholder="Nhập địa chỉ đầy đủ"></textarea>
                                        <span asp-validation-for="Address" class="validation-message"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Status & Account Section -->
                    <div class="form-section">
                        <div class="section-header">
                            <div class="section-icon account">
                                <i class="fas fa-user-shield"></i>
                            </div>
                            <div class="section-title">
                                <h4>Trạng thái & Tài khoản</h4>
                                <p>Cập nhật trạng thái hoạt động và thông tin đăng nhập</p>
                            </div>
                        </div>
                        <div class="section-content">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label class="form-label-modern">
                                            <i class="fas fa-toggle-on"></i>
                                            Trạng thái hoạt động
                                        </label>
                                        <div class="toggle-switch-container">
                                            <label class="toggle-switch">
                                                <input asp-for="IsActive" type="checkbox" />
                                                <span class="toggle-slider"></span>
                                            </label>
                                            <span class="toggle-label">Giảng viên đang hoạt động</span>
                                        </div>
                                    </div>
                                </div>

                                @if (Model.User != null)
                                {
                                    <div class="col-12">
                                        <div class="account-info-card">
                                            <div class="account-info-header">
                                                <i class="fas fa-info-circle"></i>
                                                <span>Thông tin tài khoản hiện tại</span>
                                            </div>
                                            <div class="account-info-content">
                                                <strong>Tên đăng nhập:</strong> @Model.User.Username
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label for="username" class="form-label-modern">
                                            <i class="fas fa-user-circle"></i>
                                            Tên đăng nhập
                                        </label>
                                        <input name="username" id="username" class="form-control-modern" 
                                               value="@ViewData["Username"]" placeholder="Nhập tên đăng nhập" />
                                        <span class="validation-message" id="username-validation"></span>
                                        <small class="form-help-text">
                                            @if (Model.User != null)
                                            {
                                                <text>Thay đổi tên đăng nhập hiện tại</text>
                                            }
                                            else
                                            {
                                                <text>Tạo tài khoản mới cho giảng viên</text>
                                            }
                                        </small>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label for="password" class="form-label-modern">
                                            <i class="fas fa-lock"></i>
                                            Mật khẩu mới
                                        </label>
                                        <input name="password" id="password" type="password" class="form-control-modern" 
                                               placeholder="Để trống nếu không đổi mật khẩu" />
                                        <span class="validation-message" id="password-validation"></span>
                                        <small class="form-help-text">
                                            @if (Model.User != null)
                                            {
                                                <text>Để trống nếu không muốn thay đổi mật khẩu</text>
                                            }
                                            else
                                            {
                                                <text>Bắt buộc nếu tạo tài khoản mới</text>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <!-- Form Actions -->
                <div class="form-actions">
                    <div class="action-buttons">
                        <button type="button" class="btn-modern btn-secondary" onclick="window.history.back()">
                            <i class="fas fa-arrow-left"></i>
                            <span>Quay lại</span>
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.FacultyId" class="btn-modern btn-info">
                            <i class="fas fa-eye"></i>
                            <span>Xem chi tiết</span>
                        </a>
                        <button type="submit" class="btn-modern btn-primary">
                            <i class="fas fa-save"></i>
                            <span>Cập nhật thông tin</span>
                        </button>
                    </div>
                    <div class="form-info">
                        <small class="text-muted">
                            <i class="fas fa-clock me-1"></i>
                            Tạo ngày: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                        </small>
                        @if (Model.UpdatedDate.HasValue)
                        {
                            <small class="text-muted ms-3">
                                <i class="fas fa-edit me-1"></i>
                                Cập nhật: @Model.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var hasExistingUser = @(Model.User != null ? "true" : "false");
            
            // Auto-format phone number
            const phoneInput = document.getElementById('PhoneNumber');
            if (phoneInput) {
                phoneInput.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 10) {
                        value = value.substring(0, 10);
                    }
                    e.target.value = value;
                    
                    // Add visual feedback
                    if (value.length === 10) {
                        e.target.style.borderColor = '#10b981';
                    } else {
                        e.target.style.borderColor = '#e5e7eb';
                    }
                });
            }

            // Auto-format faculty code
            const facultyCodeInput = document.getElementById('FacultyCode');
            if (facultyCodeInput) {
                facultyCodeInput.addEventListener('input', function(e) {
                    let value = e.target.value.toUpperCase();
                    e.target.value = value;
                });
            }

            // Form validation enhancement
            const form = document.querySelector('.edit-form');
            const submitBtn = document.querySelector('.btn-primary');
            
            if (form && submitBtn) {
                form.addEventListener('submit', function(e) {
                    // Add loading state
                    submitBtn.classList.add('loading');
                    submitBtn.disabled = true;
                    
                    // Show loading text
                    const btnText = submitBtn.querySelector('span');
                    const originalText = btnText.textContent;
                    btnText.textContent = 'Đang cập nhật...';
                    
                    // If validation fails, restore button
                    setTimeout(() => {
                        if (!form.checkValidity()) {
                            submitBtn.classList.remove('loading');
                            submitBtn.disabled = false;
                            btnText.textContent = originalText;
                        }
                    }, 100);
                });
            }

            // Enhanced form interactions
            const formControls = document.querySelectorAll('.form-control-modern, .form-select-modern, .textarea-modern');
            formControls.forEach(control => {
                // Add focus animations
                control.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });
                
                control.addEventListener('blur', function() {
                    this.parentElement.classList.remove('focused');
                    
                    // Add validation visual feedback
                    if (this.value.trim() !== '') {
                        this.parentElement.classList.add('has-value');
                    } else {
                        this.parentElement.classList.remove('has-value');
                    }
                });
                
                // Initial state check
                if (control.value.trim() !== '') {
                    control.parentElement.classList.add('has-value');
                }
            });

            // Toggle switch enhancement
            const toggleSwitch = document.querySelector('.toggle-switch input');
            if (toggleSwitch) {
                toggleSwitch.addEventListener('change', function() {
                    const container = this.closest('.toggle-switch-container');
                    const label = container.querySelector('.toggle-label');
                    
                    if (this.checked) {
                        container.style.borderColor = '#10b981';
                        container.style.backgroundColor = '#f0fdf4';
                        label.textContent = 'Giảng viên đang hoạt động';
                    } else {
                        container.style.borderColor = '#e5e7eb';
                        container.style.backgroundColor = 'white';
                        label.textContent = 'Giảng viên không hoạt động';
                    }
                });
                
                // Initial state
                const container = toggleSwitch.closest('.toggle-switch-container');
                const label = container.querySelector('.toggle-label');
                if (toggleSwitch.checked) {
                    container.style.borderColor = '#10b981';
                    container.style.backgroundColor = '#f0fdf4';
                    label.textContent = 'Giảng viên đang hoạt động';
                }
            }

            // Username and password validation
            const usernameInput = document.getElementById('username');
            const passwordInput = document.getElementById('password');
            
            function validateUserAccount() {
                const username = usernameInput.value.trim();
                const password = passwordInput.value.trim();
                
                // Clear previous validation messages
                document.getElementById('username-validation').textContent = '';
                document.getElementById('password-validation').textContent = '';
                
                if (!hasExistingUser && username && !password) {
                    document.getElementById('password-validation').textContent = 'Mật khẩu là bắt buộc khi tạo tài khoản mới';
                    passwordInput.style.borderColor = '#dc2626';
                } else {
                    passwordInput.style.borderColor = '#e5e7eb';
                }
            }
            
            if (usernameInput && passwordInput) {
                usernameInput.addEventListener('input', validateUserAccount);
                passwordInput.addEventListener('input', validateUserAccount);
            }

            // Email validation enhancement
            const emailInput = document.getElementById('Email');
            if (emailInput) {
                emailInput.addEventListener('blur', function() {
                    const email = this.value;
                    const emailRegex = /^[^\\s@@]+@@[^\\s@@]+\\.[^\\s@@]+$/;
                    
                    if (email && !emailRegex.test(email)) {
                        this.style.borderColor = '#dc2626';
                        showValidationMessage(this, 'Email không hợp lệ');
                    } else {
                        this.style.borderColor = '#e5e7eb';
                        hideValidationMessage(this);
                    }
                });
            }

            function showValidationMessage(input, message) {
                let validationMsg = input.parentElement.querySelector('.validation-message');
                if (validationMsg && !validationMsg.getAttribute('asp-validation-for')) {
                    validationMsg.textContent = message;
                }
            }

            function hideValidationMessage(input) {
                let validationMsg = input.parentElement.querySelector('.validation-message');
                if (validationMsg && !validationMsg.getAttribute('asp-validation-for')) {
                    validationMsg.textContent = '';
                }
            }
        });
    </script>
}